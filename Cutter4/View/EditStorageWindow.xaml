<Window x:Class="Cutter4.View.EditStorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cutter4.View"
        xmlns:vm="clr-namespace:Cutter4.ViewModel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EditStorageViewModel}"
        Title="Storage editing" Height="550" Width="500" MinHeight="436" MinWidth="360">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Added" Margin="3">
                <DataGrid Margin="3" ItemsSource="{Binding AddedCounts}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeRows="False" RowHeaderWidth="0" CanUserReorderColumns="False" ColumnWidth="auto">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Width="5*" Header="Color" ItemsSource="{Binding Source={StaticResource PanelColors}}" SelectedItemBinding="{Binding Color, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <DataGridComboBoxColumn Width="5*" Header="Width" ItemsSource="{Binding Source={StaticResource PanelWidths}}" SelectedItemBinding="{Binding Width, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Width="6*" Header="Length" Binding="{Binding Length, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <DataGridTextColumn Width="5*" Header="Count" Binding="{Binding Count, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                    <Setter Property="Background" Value="#ff3838"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>
            
            <GroupBox Header="Removed" Margin="3" Grid.Column="1">
                <DataGrid Margin="3" ItemsSource="{Binding RemovedCounts}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserResizeRows="False" RowHeaderWidth="0" CanUserReorderColumns="False" ColumnWidth="auto">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Width="5*" Header="Color" ItemsSource="{Binding Source={StaticResource PanelColors}}" SelectedItemBinding="{Binding Color, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <DataGridComboBoxColumn Width="5*" Header="Width" ItemsSource="{Binding Source={StaticResource PanelWidths}}" SelectedItemBinding="{Binding Width, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Width="6*" Header="Length" Binding="{Binding Length, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                        <DataGridTextColumn Width="5*" Header="Count" Binding="{Binding Count, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                    <Setter Property="Background" Value="#ff3838"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="1" Header="Message" Margin="3">
            <TextBox Height="150" Margin="3" Text="{Binding Message}" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="80" Height="24" Margin="3" Content="Truck delivery" Command="{Binding TruckDeliveryCommand}"/>
            <Button Grid.Column="2" Width="80" Height="24" Margin="3" Content="Apply edit" Click="Apply_Click" IsEnabled="{Binding CanApplyEdit}"/>
            <Button Grid.Column="3" Width="80" Height="24" Margin="3" Content="Cancel edit" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
