<Window x:Class="Cutter4.View.EditStorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cutter4.View"
        xmlns:vm="clr-namespace:Cutter4.ViewModel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EditStorageViewModel}"
        Title="Storage editing" Height="550" Width="420" MinHeight="436" MinWidth="339">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedDeltaCounts" Source="{Binding DeltaCounts}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="PanelKey.Width"/>
                <PropertyGroupDescription PropertyName="PanelKey.Color"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Panels to edit" Margin="3">
                <DataGrid Margin="3" x:Name="DeltaCountsDataGrid" ItemsSource="{Binding Source={StaticResource GroupedDeltaCounts}}" AutoGenerateColumns="False" CanUserResizeRows="False" RowHeaderWidth="0" CanUserResizeColumns="False" IsReadOnly="True" CanUserReorderColumns="False" ColumnWidth="auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Header="Length" Binding="{Binding PanelKey.Length}"/>
                        <DataGridTextColumn Width="*" Header="Delta count" Binding="{Binding DeltaCount}"/>
                    </DataGrid.Columns>

                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource EnumDescriptionConverter}}" FontSize="13" FontWeight="Bold" Margin="3"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <DataGridRowsPresenter/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>

                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Normal" Margin="3"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <DataGridRowsPresenter/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                </DataGrid>
            </GroupBox>
            
            <GroupBox Grid.Column="1" Header="Add panel to edit" Margin="3">
                <Grid Grid.Row="2" Margin="3 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="3" Padding="3" Text="Color:"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" Margin="3" Padding="3" VerticalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource PanelColors}}" SelectedItem="{Binding NewColor}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="3" Padding="3" Text="Width:"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" Margin="3" Padding="3" VerticalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource PanelWidths}}" SelectedItem="{Binding NewWidth}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="3" Padding="3" Width="80" Text="Length:"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="3" Padding="3" Width="80" Text="{Binding NewLength, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="3" Padding="3" Width="80" Text="Delta count:"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="3" Padding="3" Width="80" Text="{Binding NewDeltaCount,UpdateSourceTrigger=PropertyChanged}"/>
                    <Button    Grid.Row="4" Grid.Column="1" Margin="3" Padding="3" Content="Add" Command="{Binding AddNewEditItemCommand}"/>
                </Grid>
            </GroupBox>
        </Grid>
        
        <GroupBox Grid.Row="1" Header="Message" Margin="3">
            <TextBox Height="150" Margin="3" Text="{Binding Message}" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="80" Height="24" Margin="3" Content="Truck delivery" Command="{Binding }"/>
            <Button Grid.Column="2" Width="80" Height="24" Margin="3" Content="Apply edit" Click="Apply_Click" IsEnabled="{Binding CanApplyEdit}"/>
            <Button Grid.Column="3" Width="80" Height="24" Margin="3" Content="Cancel edit" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
