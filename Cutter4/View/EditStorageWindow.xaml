<Window x:Class="Cutter4.View.EditStorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cutter4.View"
        xmlns:vm="clr-namespace:Cutter4.ViewModel"
        mc:Ignorable="d"
        Title="Storage editing" Height="650" Width="400">
    <Window.DataContext>
        <vm:EditStorageViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedDeltaCounts" Source="{Binding DeltaCounts}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Key.Type"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <DockPanel Margin="3">
        <DockPanel DockPanel.Dock="Bottom">
            <Button DockPanel.Dock="Left" Width="80" Height="24" Margin="3" Content="Truck delivery" Click="TruckDelivery_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="80" Height="24" Margin="3" Content="Cancel edit" Click="Cancel_Click"/>
                <Button Width="80" Height="24" Margin="3" Content="Apply edit" Click="Apply_Click"/>
            </StackPanel>
        </DockPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Message" Margin="3">
            <TextBox Height="150" Margin="3" Text="{Binding Message}" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>
        </GroupBox>
        
        <GroupBox Header="Panels to edit" Margin="3">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" Margin="3 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="3" Padding="3" Text="Color:"/>
                    <ComboBox  Grid.Row="1" Grid.Column="0" Margin="3" Padding="3" VerticalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource PanelColors}}" SelectedItem="{Binding NewColor}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="3" Padding="3" Text="Width:"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" Margin="3" Padding="3" VerticalContentAlignment="Center" Text="{Binding NewWidth}">
                        <ComboBoxItem Content="500mm" Tag="500mm"/>
                        <ComboBoxItem Content="610mm" Tag="610mm"/>
                    </ComboBox>
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="3" Padding="3" Text="Length:"/>
                    <TextBox   Grid.Row="1" Grid.Column="2" Margin="3" Padding="3" Text="{Binding NewLength, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="3" Padding="3" Text="Delta count:"/>
                    <TextBox   Grid.Row="1" Grid.Column="3" Margin="3" Padding="3" Text="{Binding NewDeltaCount,UpdateSourceTrigger=PropertyChanged}"/>
                    <Button    Grid.Row="1" Grid.Column="4" Margin="3" Padding="3" Content="Add" Command="{Binding AddNewEditItemCommand}"/>
                </Grid>
                <DockPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="New edit item" Margin="3"/>
                    <Separator Margin="3"/>
                </DockPanel>
                <DataGrid Margin="3" x:Name="DeltaCountsDataGrid" ItemsSource="{Binding Source={StaticResource GroupedDeltaCounts}}" AutoGenerateColumns="False" CanUserResizeRows="False" RowHeaderWidth="0" CanUserResizeColumns="False" IsReadOnly="True" CanUserReorderColumns="False" ColumnWidth="auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Length" Binding="{Binding Key.Length}"/>
                        <DataGridTextColumn Header="Delta count" Binding="{Binding Value}"/>
                    </DataGrid.Columns>

                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding Name.Color}" FontSize="13" FontWeight="Normal" Margin="3"/>
                                            <TextBlock Text="|"                    FontSize="13" Margin="3"/>
                                            <TextBlock Text="{Binding Name.Width}" FontSize="13" FontWeight="Normal" Margin="3"/>
                                        </StackPanel>
                                        <Separator Grid.Column="1" Margin="3"/>
                                    </DockPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</Window>
