<Window x:Class="Cutter4.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cutter4.View"
        xmlns:vm="clr-namespace:Cutter4.ViewModel"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EditStorageViewModel}"
        Loaded="Window_Loaded"
        Title="Cutter4" Height="650" Width="630" MinHeight="295" MinWidth="342">
    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Cutting" Padding="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Kapuk" Margin="3" >
                        <DataGrid ItemsSource="{Binding Kapuk}" Margin="3" AutoGenerateColumns="False" CanUserResizeRows="False" CanUserDeleteRows="True" CanUserSortColumns="False" CanUserReorderColumns="False" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="Length" Binding="{Binding Length, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                                <DataGridTextColumn Width="*" Header="Height" Binding="{Binding Height, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                                <DataGridComboBoxColumn Width="*" Header="Color" ItemsSource="{Binding Source={StaticResource PanelColors}}" SelectedItemBinding="{Binding Color, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                                <DataGridTextColumn Width="*" Header="Serial Number" Binding="{Binding SerialNumber, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <StackPanel Grid.Column="1" Margin="0 20 0 0">
                        <Button Grid.Row="1" Margin="3" Height="26" Content="Calculate" Command="{Binding CalculateCommand}"/>
                        <Button Grid.Row="2" Margin="3" Height="26" Content="New cut" Command="{Binding NewCutCommand}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Margin="3" Padding="3" Text="{Binding OutputText}" IsReadOnly="True" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Column="1">
                        <Button Content="Reorder cut" Click="ReorderCut_Click" IsEnabled="{Binding CanSave}" Height="26" Margin="3"/>
                        <Button Grid.Row="1" Margin="3" Height="26" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"/>
                        <Button Content="Print" Click="Print_Click" IsEnabled="{Binding CanSave}" Height="26" Margin="3"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Storage" Padding="3">
            <Grid Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Row="1" Header="500 mm" Margin="3">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <TextBlock Text="No. 13200mm: " FontWeight="DemiBold" Margin="3"/>
                            <TextBlock Text="{Binding MaxLength500SPCount}" Margin="3"/>
                        </StackPanel>

                        <DataGrid Margin="3" ItemsSource="{Binding SPs500}" AutoGenerateColumns="False" CanUserResizeRows="False" CanUserSortColumns="True" RowHeaderWidth="0" CanUserResizeColumns="False" IsReadOnly="True" CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Length" Width="*" Binding="{Binding}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
                <GroupBox Grid.Row="1" Grid.Column="1" Header="610 mm" Margin="3">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <TextBlock Text="No. 13200mm: " FontWeight="DemiBold" Margin="3"/>
                            <TextBlock Text="{Binding MaxLength610SPCount}" Margin="3"/>
                        </StackPanel>
                        
                        <DataGrid Margin="3" ItemsSource="{Binding SPs610}" AutoGenerateColumns="False" CanUserResizeRows="False" CanUserSortColumns="True" RowHeaderWidth="0" CanUserResizeColumns="False" IsReadOnly="True" CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Length" Width="*" Binding="{Binding}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <StackPanel Grid.Column="2">
                    <TextBlock Height="18" Margin="3" Padding="3" Text="Color:" FontWeight="DemiBold"/>
                    <ComboBox Height="24" Margin="3" Padding="3" VerticalContentAlignment="Center" ItemsSource="{Binding Source={StaticResource PanelColors}}" SelectedItem="{Binding SelectedStorageColor}"/>
                    <Separator Margin="3 6 3 6"/>
                    <Button Height="24" Margin="3" Content="Edit storage" Click="EditStorage_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="History" Padding="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="Actions on storage" Margin="3">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <Button Content="Revert and Modify" Width="120" Height="24" Margin="3" Command="{Binding RevertOrderCommand}" IsEnabled="{Binding CanRevertOrder}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding StorageHistory}" SelectedItem="{Binding SelectedStorageHistoryEntry}" Margin="3" AutoGenerateColumns="False" CanUserResizeRows="False" CanUserSortColumns="False" RowHeaderWidth="0" IsReadOnly="True" CanUserReorderColumns="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateTime}" Width="1.25*"/>
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="Details" Margin="3">
                    <TextBox Text="{Binding SelectedStorageHistoryEntry.Details, Mode=OneWay}" Margin="3" Padding="3" IsReadOnly="True" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </GroupBox>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
