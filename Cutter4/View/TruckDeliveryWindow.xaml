<Window x:Class="Cutter4.View.TruckDeliveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cutter4.View"
        xmlns:vm="clr-namespace:Cutter4.ViewModel"
        mc:Ignorable="d"
        Title="Truck delivery" SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:TruckDeliveryViewModel/>
    </Window.DataContext>
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock               Width="auto" Height="24" Margin="3" Padding="3" Text="Imported panel count:" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Width="40"   Height="24" Margin="3" Padding="3" Text="{Binding CountToImport, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Height="24" Margin="3" Padding="3" Content="Import" Click="Import_Click" IsEnabled="{Binding CanImport}"/>
            <Button Width="80" Height="24" Margin="3" Padding="3" Content="Cancel" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
